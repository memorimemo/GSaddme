# Server
NODE_ENV=development
PORT=3013

# Trust Proxy Configuration
# Set to the number of trusted proxies between clients and this server.
# 0 = disabled (default for development)
# 1 = trust first proxy (typical for single load balancer)
# 2+ = trust multiple proxies
# IMPORTANT: Only trust proxies you control. Incorrect settings can allow IP spoofing.
TRUST_PROXY=0

# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME?schema=public&connection_limit=20&pool_timeout=20"

# Authentication
# IMPORTANT: Generate secure random tokens for production!
# Use: openssl rand -hex 32
CLIENT_APP_TOKEN=replace_with_long_random_client_token_min_32_chars
CLIENT_APP_SLUG=default-client-app
CLIENT_APP_NAME=Default Client App
JWT_SECRET=replace_with_secure_random_jwt_secret_min_64_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_BOOTSTRAP_TOKEN=replace_with_long_random_admin_token_min_32_chars
ADMIN_JWT_SECRET=replace_with_secure_random_admin_jwt_secret_min_64_chars
ADMIN_JWT_EXPIRES_IN=15m

# AWS
# IMPORTANT: Use IAM roles in production instead of access keys when possible
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=your-bucket-name
AWS_PRESIGNED_URL_EXPIRES_IN=900
AWS_REKOGNITION_MIN_CONFIDENCE=75

# OpenAI
# IMPORTANT: Never commit actual API keys!
OPENAI_API_KEY=
OPENAI_RESPONSES_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=chatgpt-image-latest
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_QUALITY=high
OPENAI_IMAGE_FORMAT=jpeg
OPENAI_IMAGE_BACKGROUND=opaque
OPENAI_IMAGE_INPUT_FIDELITY=high
OPENAI_REASONING_EFFORT=high

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=galatasaray.jobs
RABBITMQ_QUEUE=galatasaray.jobs.image-generate
RABBITMQ_ROUTING_KEY=jobs.image.generate
RABBITMQ_PREFETCH=10
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=5

# Uploads
MAX_UPLOAD_BYTES=15728640
MAX_IMAGE_DIMENSION=2048
TEMPLATE_SYNC_INTERVAL_MS=60000

# Rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# CORS
# SECURITY WARNING: Never use * in production!
# Production: Set to specific domain(s) e.g. https://app.example.com,https://admin.example.com
# Development: Use * only for local testing
CORS_ORIGINS=*

# Worker
WORKER_MAX_CONCURRENT_JOBS=2
