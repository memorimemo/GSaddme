    {
      "name": "🏥 Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "DB, Redis ve RabbitMQ bağlantılarını kontrol eder. `status: ok` ise tüm servisler sağlıklı."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Overall status is ok', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('DB is ok', () => {",
                  "    pm.expect(pm.response.json().checks.db).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('Redis is ok', () => {",
                  "    pm.expect(pm.response.json().checks.redis).to.eql('ok');",
                  "});",
                  "",
                  "pm.test('RabbitMQ is ok', () => {",
                  "    const rmq = pm.response.json().checks.rabbitmq;",
                  "    pm.expect(rmq).to.be.oneOf(['ok', 'degraded']);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "console.log('Uptime:', body.uptime, 's | DB:', body.checks.db, '| Redis:', body.checks.redis, '| RabbitMQ:', body.checks.rabbitmq);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "🔐 Auth — Client",
      "description": "Client token ile JWT access + refresh token alınır. Access token süresi 1 saattir.",
      "item": [
        {
          "name": "1. Get Access Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "token"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clientToken\": \"{{client_token}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "Client token ile access token ve refresh token alır. Test script otomatik olarak `access_token` ve `refresh_token` koleksiyon değişkenlerine kaydeder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Has accessToken', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('accessToken');",
                  "});",
                  "",
                  "pm.test('Has refreshToken', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('refreshToken');",
                  "});",
                  "",
                  "pm.test('TokenType is Bearer', () => {",
                  "    pm.expect(pm.response.json().tokenType).to.eql('Bearer');",
                  "});",
                  "",
                  "// Tokenları koleksiyon değişkenlerine kaydet",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.accessToken);",
                  "pm.collectionVariables.set('refresh_token', body.refreshToken);",
                  "",
                  "console.log('✅ access_token kaydedildi | Süre:', body.expiresIn);"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "2. Refresh Access Token",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": { "language": "json" }
              }
            },
            "description": "Süresi dolmuş access token'ı refresh token kullanarak yeniler. Yeni `access_token` otomatik kaydedilir."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Has accessToken', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('accessToken');",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.accessToken);",
                  "",
                  "console.log('✅ access_token yenilendi | Süre:', body.expiresIn);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
