    {
      "name": "📖 Swagger UI",
      "item": [
        {
          "name": "Open API Docs (JSON)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/docs/openapi.json",
              "host": ["{{base_url}}"],
              "path": ["docs", "openapi.json"]
            },
            "description": "OpenAPI spec'ini JSON formatında döner. Swagger UI için: {{base_url}}/docs/"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Is valid OpenAPI', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('openapi');",
                  "    pm.expect(body).to.have.property('paths');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
