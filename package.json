{
  "name": "galatasaray-api",
  "version": "1.0.0",
  "description": "Asynchronous REST API for Galatasaray player image compositing with OpenAI and AWS services",
  "main": "app.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/job.worker.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:validate": "prisma validate",
    "templates:sync": "node src/scripts/sync-templates.js"
  },
  "keywords": [
    "express",
    "rest-api",
    "image-processing",
    "openai",
    "aws-s3",
    "aws-rekognition",
    "rabbitmq",
    "postgresql",
    "prisma"
  ],
  "author": "Clerion",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.823.0",
    "@aws-sdk/client-s3": "^3.823.0",
    "@aws-sdk/lib-storage": "^3.823.0",
    "@aws-sdk/s3-request-presigner": "^3.823.0",
    "@prisma/client": "^6.19.0",
    "amqplib": "^0.10.8",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "file-type": "^22.0.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "openai": "^6.42.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^5.0.0",
    "sharp": "^0.35.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.19.0"
  }
}
